import telebot
import boto3
import os
from dotenv import load_dotenv

load_dotenv()
API_KEY = os.getenv("API_KEY")
AWS_ACCESS_KEY = os.getenv("AWS_ACCESS_KEY")
AWS_SECRET_KEY = os.getenv("AWS_SECRET_KEY")
INSTANCE_ID = "YOUR_EC2_INSTANCE_ID"

bot = telebot.TeleBot(API_KEY)
ec2 = boto3.client("ec2", aws_access_key_id=AWS_ACCESS_KEY, aws_secret_access_key=AWS_SECRET_KEY, region_name="ap-south-1")

@bot.message_handler(commands=['start'])
def start(message):
    bot.reply_to(message, "Welcome to AWS EC2 Automation Bot 🔥")

@bot.message_handler(commands=['start_ec2'])
def start_ec2(message):
    ec2.start_instances(InstanceIds=[INSTANCE_ID])
    bot.reply_to(message, "✅ EC2 Instance Started")

@bot.message_handler(commands=['stop_ec2'])
def stop_ec2(message):
    ec2.stop_instances(InstanceIds=[INSTANCE_ID])
    bot.reply_to(message, "❌ EC2 Instance Stopped")

@bot.message_handler(commands=['status'])
def status(message):
    response = ec2.describe_instances(InstanceIds=[INSTANCE_ID])
    state = response['Reservations'][0]['Instances'][0]['State']['Name']
    bot.reply_to(message, f"EC2 Instance Status: {state}")

bot.polling() 
